{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rem",
  "version": "0.1.11",
  "identifier": "com.rem.remote",
  "build": {
    "beforeDevCommand": "pnpm web:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rem — Remote Control",
        "width": 1040,
        "height": 820,
        "minWidth": 560,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ArthurNsongan/Rem-Remote-Control/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNUI3ODNBNDcyMUU0MTUKUldRVjVDRkhPbmhiYjc5Z3RvY085YjRzK1JZWDl1TjNMb1FkTnJ0UkxBZ2phOFJSeEl4ZllTeUgK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "ArthurNsongan",
    "copyright": "Copyright 2026 ArthurNsongan",
    "homepage": "https://rem.nade.click/",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE.md",
    "category": "Utility",
    "shortDescription": "Contrôle ton PC depuis ton téléphone, ta tablette ou un autre ordinateur.",
    "longDescription": "Rem transforme ton ordinateur en machine pilotable à distance depuis n'importe quel navigateur du réseau local : souris, clavier, média, écran tactile, caméra et audio. Appairage par code PIN, rien ne quitte ton réseau.",
    "targets": [
      "msi",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "pulseaudio-utils",
          "libpipewire-0.3-0"
        ]
      }
    }
  }
}
