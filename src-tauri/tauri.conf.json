{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rem",
  "version": "0.1.2",
  "identifier": "com.rem.remote",
  "build": {
    "beforeDevCommand": "pnpm web:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rem — Remote Control",
        "width": 1040,
        "height": 820,
        "minWidth": 560,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libxdo3",
          "pulseaudio-utils"
        ]
      }
    }
  }
}
